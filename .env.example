# ───────── Database ─────────
# Local: docker compose (npm run db:up) or local cluster (npm run db:local:start) — both on port 5434
# Supabase / Vercel: use the pooler URL from Supabase → Project Settings → Database
#   e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/parking?schema=public"
# Tests TRUNCATE tables → must be a LOCAL database (remote URLs are refused automatically)
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/parking_test?schema=public"

# ───────── App ─────────
NODE_ENV=development
LOG_LEVEL=info
TZ_NAME=Asia/Riyadh
# generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ───────── Reminders ─────────
# Vercel: Vercel Cron calls GET /api/cron/reminders daily (vercel.json) with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=change-me-cron-secret
# Self-hosted (next start / Docker): in-process scheduler (ignored on Vercel)
REMINDER_CRON="0 8 * * *"
SCHEDULER_ENABLED=true

# ───────── Seed users (npm run db:seed) — change the passwords in production ─────────
SEED_ADMIN_EMAIL=admin@parking.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_OWNER_EMAIL=owner@parking.local
SEED_OWNER_PASSWORD=Owner@12345
SEED_STAFF_EMAIL=staff@parking.local
SEED_STAFF_PASSWORD=Staff@12345

# ───────── Email (SMTP) — Mailpit in docker compose catches everything at http://localhost:8025 ─────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Parking Management <no-reply@parking.local>"
# false = emails are only logged (no SMTP needed)
EMAIL_ENABLED=false

# ───────── Future channels (provider not wired yet) ─────────
WHATSAPP_ENABLED=false
SMS_ENABLED=false
